# Common configuration for local development and EC2.
# Allowed values: local, ec2
APP_ENV=local
APP_NAME=AI Summary API

# Local authentication only. Leave all four values unset when APP_ENV=ec2.
# Option A: temporary credentials. Populate only in .env, never here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Option B: AWS CLI/SSO profile. Do not configure both options unless needed.
# AWS_PROFILE=your-corpay-sso-profile
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Approved Bedrock foundation-model ID or inference-profile ID.
BEDROCK_MODEL_ID=replace-with-approved-bedrock-model-or-inference-profile-id

# Bedrock Guardrail used to mask PII before model inference.
BEDROCK_GUARDRAIL_ID=replace-with-guardrail-id
BEDROCK_GUARDRAIL_VERSION=1

# Optional custom/VPC Bedrock Runtime endpoint. Leave empty for the AWS default.
BEDROCK_ENDPOINT_URL=

# Boto3 uses the standard AWS credential chain. Never commit populated values.
# AWS_SESSION_TOKEN is mandatory when it was issued with temporary credentials.

LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=8.0

# CloudWatch Embedded Metric Format. Keep false for local development and set
# true on EC2 after installing the CloudWatch Agent configuration in deploy/.
CLOUDWATCH_EMF_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=Corpay/Summarizer
# Stable low-cardinality deployment name, for example dev, staging, or prod.
CLOUDWATCH_ENVIRONMENT=local

# Caller authentication. Must be true when APP_ENV=ec2.
# Callers present an OAuth2 client-credentials access token as `Authorization: Bearer <token>`.
AUTH_ENABLED=false

# JWKS document published by the IdP. Non-secret. Examples:
#   Entra ID: https://login.microsoftonline.com/<TENANT_ID>/discover/v2.0/keys
#   Okta:     https://<ORG>.okta.com/oauth2/<AUTH_SERVER_ID>/v1/keys
#   Ping:     https://<HOST>/ext/oauth/jwks
OIDC_JWKS_URL=

# Must equal the `iss` claim in issued tokens, character for character.
OIDC_ISSUER=

# The API's own identifier, matched against the token `aud` claim.
OIDC_AUDIENCE=

# Comma-separated scopes/app-roles a caller must hold. Empty means any valid
# token for this audience is accepted.
OIDC_REQUIRED_SCOPE=summarizer.invoke

# Asymmetric only. RS*/PS*/ES*/Ed* are permitted; HS* is rejected at startup.
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=60

# Comma-separated browser origins. Empty disables CORS entirely, which is
# correct for server-to-server callers. '*' is rejected when APP_ENV=ec2.
CORS_ALLOWED_ORIGINS=*

# These three settings must all be false when APP_ENV=ec2.
LOG_SANITIZATION_DETAILS=false

# Set false when API consumers must not receive original PII-bearing content.
INCLUDE_ORIGINAL_CONTENT=true

# Full prompts are useful for local debugging but should not be returned on EC2.
INCLUDE_LLM_CALL_INPUTS=true

# Set these for the approved model to enable cost estimates. Zero means unknown/not configured.
LLM_INPUT_COST_PER_MILLION_TOKENS_USD=0
LLM_OUTPUT_COST_PER_MILLION_TOKENS_USD=0
USD_TO_GBP_EXCHANGE_RATE=0.79
