# Production/EC2 environment file. Copy to /etc/summarizer-api.env on the
# instance (referenced by deploy/summarizer-api.service EnvironmentFile=),
# fill in the real values below, then:
#   chown root:summarizer /etc/summarizer-api.env
#   chmod 640 /etc/summarizer-api.env
# This file must never be committed with real values.

APP_ENV=ec2
APP_NAME=AI Summary API

# Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN /
# AWS_PROFILE here. On EC2, credentials come from the attached instance
# profile role (see deploy/iam-policy.json). Setting any of them causes
# validate_runtime() to reject startup.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Approved Bedrock foundation-model ID or inference-profile ID.
BEDROCK_MODEL_ID=replace-with-approved-bedrock-model-or-inference-profile-id

# Bedrock Guardrail used to mask PII before model inference.
BEDROCK_GUARDRAIL_ID=replace-with-guardrail-id
BEDROCK_GUARDRAIL_VERSION=1

# Optional custom/VPC Bedrock Runtime endpoint. Leave empty for the AWS default.
BEDROCK_ENDPOINT_URL=

LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=8.0

# Requires the CloudWatch Agent config in deploy/cloudwatch-agent.json to be
# installed on the instance.
CLOUDWATCH_EMF_ENABLED=true
CLOUDWATCH_METRICS_NAMESPACE=Corpay/Summarizer
# Stable low-cardinality deployment name: dev, staging, or prod.
CLOUDWATCH_ENVIRONMENT=replace-with-dev-staging-or-prod

# Must be true on ec2 (enforced at startup).
AUTH_ENABLED=false

# JWKS document published by the IdP. Non-secret. Examples:
#   Entra ID: https://login.microsoftonline.com/<TENANT_ID>/discover/v2.0/keys
#   Okta:     https://<ORG>.okta.com/oauth2/<AUTH_SERVER_ID>/v1/keys
#   Ping:     https://<HOST>/ext/oauth/jwks
OIDC_JWKS_URL=replace-with-real-jwks-url

# Must equal the `iss` claim in issued tokens, character for character.
OIDC_ISSUER=replace-with-real-issuer

# The API's own identifier, matched against the token `aud` claim.
OIDC_AUDIENCE=replace-with-real-audience

# Comma-separated scopes/app-roles a caller must hold.
OIDC_REQUIRED_SCOPE=summarizer.invoke

# Asymmetric only. RS*/PS*/ES*/Ed* are permitted; HS* is rejected at startup.
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=60

# '*' is rejected on ec2. Empty is correct for server-to-server callers
# (e.g. behind ALB/Nginx with no direct browser access); otherwise list the
# real caller origins.
CORS_ALLOWED_ORIGINS=

# All three must be false on ec2 (enforced at startup).
LOG_SANITIZATION_DETAILS=false
INCLUDE_ORIGINAL_CONTENT=false
INCLUDE_LLM_CALL_INPUTS=false

# Set these for the approved model to enable cost estimates. Zero means unknown/not configured.
LLM_INPUT_COST_PER_MILLION_TOKENS_USD=0
LLM_OUTPUT_COST_PER_MILLION_TOKENS_USD=0
USD_TO_GBP_EXCHANGE_RATE=0.79
